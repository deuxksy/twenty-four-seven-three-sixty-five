services:
  beszel:
    image: docker.io/henrygd/beszel:latest
    container_name: beszel-hub
    restart: unless-stopped
    ports:
      - "127.0.0.1:8090:8090"
    volumes:
      - /data/beszel/data:/beszel_data
      - /data/beszel/socket:/beszel_socket
    environment:
      - TZ=Asia/Seoul
      - APP_URL=https://brla.bun-bull.ts.net:8090
    networks:
      - monitoring

networks:
  monitoring:
    name: monitoring
    external: true
