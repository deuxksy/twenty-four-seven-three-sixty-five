# Hermes Agent config - Ansible 자동 생성
_config_version: 26
model:
  default: google/gemma-4-26b-a4b-qat
  provider: custom:aperture

providers: {}

custom_providers:
- name: aperture
  base_url: http://ai/v1
  key_env: ANTHROPIC_API_KEY
  api_mode: chat_completions

timezone: Asia/Seoul

terminal:
  backend: local

approvals:
  mode: yolo

discord:
  require_mention: false
  free_response_channels:
    - "1511797315722149928"
  reactions: true
