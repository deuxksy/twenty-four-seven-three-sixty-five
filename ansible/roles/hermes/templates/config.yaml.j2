# Hermes Agent config - Ansible 자동 생성
model:
  default: ark-code-latest
  provider: custom
  base_url: https://ark.ap-southeast.bytepluses.com/api/coding/v1
  api_key: {{ lookup('env', 'ANTHROPIC_API_KEY') }}

terminal:
  backend: local

approvals:
  mode: yolo

gateway:
  platforms:
    discord:
      require_mention: false
      free_response_channels:
        - "1511797315722149928"
      reactions: true
      extra:
        slash_commands: false
