services:
  hermes:
    image: nousresearch/hermes-agent:latest
    container_name: hermes
    restart: unless-stopped
    command: gateway run
    ports:
      - "8642:8642"
      - "9119:9119"
    volumes:
      - /data/hermes:/opt/data
    environment:
      - TZ=Asia/Seoul
      - HERMES_DASHBOARD=1
