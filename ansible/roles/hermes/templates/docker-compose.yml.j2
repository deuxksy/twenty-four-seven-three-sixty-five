services:
  hermes:
    image: nousresearch/hermes-agent:latest
    container_name: hermes
    restart: unless-stopped
    user: "10000:10000"
    command: gateway run
    network_mode: host
    volumes:
      - /data/hermes/data:/opt/data
      - /data/git:/opt/data/git
      - /data/hermes/ssh:/opt/data/home/.ssh
    env_file:
      - /data/hermes/data/.env
