services:
  code-server:
    image: codercom/code-server:latest
    container_name: code-server
    restart: unless-stopped
    user: "1001:1001"
    command: --auth password
    ports:
      - "8080:8080"
    volumes:
      - /data/code-server:/home/coder
    environment:
      - PASSWORD={{ code_server_password | default('changeme') }}
      - TZ=Asia/Seoul
