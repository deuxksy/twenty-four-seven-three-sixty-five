# SOPS 유틸리티 (source .env.local 로 로드)
# 함수 + alias 구조: 인터랙티브 셸(alias)과 스크립트(함수) 양쪽에서 재사용

export SOPS_AGE_KEY_FILE="$(pwd)/keys.txt"

sops-dec() { sops -d --input-type binary --output-type binary .env.sops > .env; }
sops-enc() { sops -e --input-type binary --output-type binary .env > .env.sops; }
sops-load() { set -a; source .env; set +a; }

alias dec=sops-dec
alias enc=sops-enc
alias load=sops-load
