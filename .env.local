# SOPS가 개인키를 찾을 수 있도록 keys.txt 절대 경로 지정
export SOPS_AGE_KEY_FILE="$(pwd)/keys.txt"

# [enc] 평문화 파일을 binary 로 인식하게해서 .env 평문을 .env.sops 파일로 암호화.
alias enc="sops -e --input-type binary --output-type binary .env > .env.sops"

# [dec] 암호화 파일을 binary 로 인식하게해서 .env.sops 암호화 을 .env 로 평문화 하기.
alias dec="sops -d --input-type binary --output-type binary .env.sops > .env"

# [load] 부활한 평문 .env 파일의 변수들을 쉘 시스템 메모리(RAM)에 일괄 탑재
alias load="export \$(cat .env | xargs)"